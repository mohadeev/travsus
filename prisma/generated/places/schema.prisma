// Define MongoDB connection
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL_PLACES")
}

generator client {
  provider = "prisma-client-js"
  output   = "../prisma/generated/places"
}

// Continent Model
model Continent {
  id        String              @id @default(auto()) @map("_id") @db.ObjectId
  code      String              @unique
  contentId String              @db.ObjectId
  content   TranslatableContent @relation("ContinentContent", fields: [contentId], references: [id])
  geo       GeoCoordinates?
  image     Image?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  countries Country[]           @relation("ContinentCountries")
}

// Country Model
model Country {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  code        String              @unique
  code3       String              @unique
  contentId   String              @db.ObjectId
  content     TranslatableContent @relation("CountryContent", fields: [contentId], references: [id])
  continentId String?             @db.ObjectId
  continent   Continent?          @relation("ContinentCountries", fields: [continentId], references: [id])
  cities      City[]              @relation("CountryCities")
  states      State[]             @relation("CountryStates")
  geo         GeoCoordinates
  image       Image?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  type        String?
  places      Place[]
}

// State/Province Model
model State {
  id        String              @id @default(auto()) @map("_id") @db.ObjectId
  countryId String              @db.ObjectId
  country   Country             @relation("CountryStates", fields: [countryId], references: [id])
  contentId String              @db.ObjectId
  content   TranslatableContent @relation("StateContent", fields: [contentId], references: [id])
  code      String?
  geo       GeoCoordinates?
  image     Image?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  type      String?
  cities    City[]
  places    Place[]

  @@unique([countryId, code])
  @@index([countryId])
}

// City Model
model City {
  id         String              @id @default(auto()) @map("_id") @db.ObjectId
  countryId  String              @db.ObjectId
  country    Country             @relation("CountryCities", fields: [countryId], references: [id])
  stateId    String?             @db.ObjectId
  state      State?              @relation(fields: [stateId], references: [id])
  contentId  String              @db.ObjectId
  content    TranslatableContent @relation("CityContent", fields: [contentId], references: [id])
  geo        GeoCoordinates
  image      Image?
  population Int?
  timezone   String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  code3      String?
  type       String?
  places     Place[]

  @@index([countryId])
  @@index([stateId])
}

// Place Model
model Place {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  cityId      String?             @db.ObjectId
  city        City?               @relation(fields: [cityId], references: [id])
  stateId     String?             @db.ObjectId
  state       State?              @relation(fields: [stateId], references: [id])
  countryId   String?             @db.ObjectId
  country     Country?            @relation(fields: [countryId], references: [id])
  contentId   String              @db.ObjectId
  content     TranslatableContent @relation("PlaceContent", fields: [contentId], references: [id])
  geo         GeoCoordinates
  image       Image?
  type        String
  category    String
  subcategory String?
  tags        String[]
  rating      Float?
  address     String?
  website     String?
  phone       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([cityId])
  @@index([stateId])
  @@index([countryId])
}

// Translatable Content Model
model TranslatableContent {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  entity           String
  translations     TranslatedText[]
  alternativeNames AlternativeName[]
  // Opposite Relations
  continents       Continent[]       @relation("ContinentContent")
  countries        Country[]         @relation("CountryContent")
  states           State[]           @relation("StateContent")
  cities           City[]            @relation("CityContent")
  places           Place[]           @relation("PlaceContent")
  code3            String?
  type             String?
}

// Translated Text Model
model TranslatedText {
  id        String              @id @default(auto()) @map("_id") @db.ObjectId
  contentId String              @db.ObjectId
  content   TranslatableContent @relation(fields: [contentId], references: [id])
  code3     String?
  language  String
  text      String
  type      String?

  @@index([contentId])
}

// AlternativeName Embedded Type
type AlternativeName {
  text      String
  source    String
  createdAt DateTime @default(now())
}

// GeoCoordinates Embedded Type
type GeoCoordinates {
  lat Float
  log Float
}

// Image Embedded Type
type Image {
  url        String?
  public_id  String?
  uploadFrom String?
}
