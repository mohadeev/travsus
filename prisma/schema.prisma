// schema.prisma

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                     String    @id @default(auto()) @map("_id") @db.ObjectId
  email                  String    @unique
  username               String?
  phone                  String?
  password               String
  senders                Json?
  date                   DateTime  @default(now())
  library                Json?
  accountData            Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  savedList              Json?
  passwordResetToken     String?   // Optional: Token for password reset
  passwordResetTokens    String[]  // Array of used password reset tokens
  passwordHistory        String[]  // Array of user's password history
  passwordResetTokenExpiry DateTime? // Optional: Expiry for the reset token

  bookings               Booking[]  // Relation to Booking model
  subscriptions          Subscription[] // Relation to Subscription model
  toursCreated           Tour[]  // Relation to Tours created by the user

  @@map("users")
}

model Subscription {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  userId            String    @db.ObjectId // Reference to User
  subscriptionType  String    // Type of subscription (e.g., monthly, yearly)
  startDate         DateTime  // Subscription start date
  endDate           DateTime? // Subscription end date (optional)
  isActive          Boolean   @default(true) // Is the subscription active
  createdAt         DateTime  @default(now()) // Creation date
  updatedAt         DateTime  @updatedAt // Update date

  user              User      @relation(fields: [userId], references: [id]) // Relation to User model

  @@map("subscriptions")
}

model Tour {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  creatorId     String    @db.ObjectId  // Foreign key for User
  creator       User      @relation(fields: [creatorId], references: [id]) // Relation to User (creator of the tour)
  name          String?
  subtitle      String?
  overview      String?
  productCategory String?
  slug          String?
  images        Json[]    // Array of Strings
  people        Json[]    // Array of Strings
  services      Json[]    // Array of Strings
  places        Json[]    // Array of Strings
  highlights    Json[]    // Array of Strings
  days          Json[]    // Array of Strings
  paths         Json[]    // Array of Strings
  price         String?
  region        Json[]    // Array of Strings
  descount      String?
  start         Json?     // Reference to the StartEnd model
  end           Json?     // Reference to the StartEnd model
  reviews       Json[]    // Array of JSON objects for storing reviews
  lang          String?
  tourfor       String?
  updated       Boolean   @default(false) // Default value set to false
  conclusion    String?
  tags          Json[]    // Array of Strings
  keyphrase     Json[]    // Array of Strings (corrected spelling from "keyphrase")
  createdAt     DateTime  @default(now()) // Auto set the createdAt field
  updatedAt     DateTime  @updatedAt      // Auto set the updatedAt field

  bookings      Booking[] // Relation to Booking model

  @@map("tours")
}

model Booking {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  user          User     @relation(fields: [userId], references: [id])  // Relation to User
  userId        String   @db.ObjectId  // Foreign key for the User
  tour          Tour     @relation(fields: [tourId], references: [id])  // Relation to Tour
  tourId        String   @db.ObjectId  // Foreign key for the Tour
  numberOfSeats Int      // Number of seats booked
  startDate     DateTime // Start date of the tour booking
  createdAt     DateTime @default(now()) // Auto set the createdAt field
  updatedAt     DateTime @updatedAt      // Auto set the updatedAt field

  @@map("bookings")
}
