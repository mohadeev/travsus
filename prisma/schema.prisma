// schema.prisma

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                     String    @id @default(auto()) @map("_id") @db.ObjectId
  email                  String    @unique
  username               String?
  phone                  String?
  password               String
  senders                Json?
  date                   DateTime  @default(now())
  library                Json?
  accountData            Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  savedList              Json?
  passwordResetToken     String?   // Optional: Token for password reset
  passwordResetTokens    String[]  // Array of used password reset tokens
  passwordHistory        String[]  // Array of user's password history
  passwordResetTokenExpiry DateTime? // Optional: Expiry for the reset token
  businesses             Business[] @relation("UserBusinesses")
  bookings               Booking[]  @relation("UserBookings")
  subscriptions          Subscription[] @relation("UserSubscriptions")
  toursCreated           Tour[]  @relation("UserTours")
  profileImage        Json?    // JSON object storing {url, public_id}

  @@map("users")
}
 
model Business {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  creatorId           String   @db.ObjectId  // Foreign key for User
  name                String?
  adminName           String?
  email               String   @unique
  phoneNumber         String
  address             String?
  country             String?
  registrationNumber  String?  // Optional registration number
  bankName            String?
  accountNumber       String?
  registrationDate    DateTime?

  // Profile Image
  profileImage        Json?    // JSON object storing {url, public_id}

  // Cover Image
  coverImage          Json?    // JSON object storing {url, public_id}

  // Relation to Tours created by the business
  toursCreated        Tour[]   @relation("BusinessTours")

  // Creator relation to the User model
  creator             User     @relation("UserBusinesses", fields: [creatorId], references: [id])

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("businesses")
}




model Subscription {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  userId            String    @db.ObjectId // Reference to User
  subscriptionType  String    // Type of subscription (e.g., monthly, yearly)
  startDate         DateTime  // Subscription start date
  endDate           DateTime? // Subscription end date (optional)
  isActive          Boolean   @default(true) // Is the subscription active
  createdAt         DateTime  @default(now()) // Creation date
  updatedAt         DateTime  @updatedAt // Update date

  user              User      @relation("UserSubscriptions", fields: [userId], references: [id]) // Relation to User model

  @@map("subscriptions")
}

model Tour {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  creatorId     String    @db.ObjectId  // Foreign key for User
  creator       User      @relation("UserTours", fields: [creatorId], references: [id]) // Relation to User (creator of the tour)
  businessId    String?   @db.ObjectId  // Foreign key for Business
  business      Business? @relation("BusinessTours", fields: [businessId], references: [id]) // Relation to Business model
  name          String?
  subtitle      String?
  overview      String?
  productCategory String?
  slug          String?
  images        Json[]    // Array of images (stored as JSON)
  people        Json[]    // Array of people data (stored as JSON)
  services      Json[]    // Array of services (stored as JSON)
  places        Json[]    // Array of places (stored as JSON)
  highlights    Json[]    // Array of highlights (stored as JSON)
  days          Json[]    // Array of days itinerary (stored as JSON)
  paths         Json[]    // Array of paths (stored as JSON)
  price         String?
  discount      String?   // Corrected spelling
  start         Json?     // Start location (stored as JSON)
  end           Json?     // End location (stored as JSON)
  reviews       Json[]    // Array of reviews (stored as JSON)
  lang          String?
  tourfor       String?   // Audience (target group)
  updated       Boolean   @default(false) // Default value set to false
  conclusion    String?
  tags          Json[]    // Array of tags (stored as JSON)
  keyphrase     Json[]    // Array of key phrases (stored as JSON)
  createdAt     DateTime  @default(now()) // Auto set the createdAt field
  updatedAt     DateTime  @updatedAt      // Auto set the updatedAt field

  bookings      Booking[] @relation("TourBookings") // Relation to Booking model

  @@map("tours")
}

model Booking {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  user          User     @relation("UserBookings", fields: [userId], references: [id])  // Relation to User
  userId        String   @db.ObjectId  // Foreign key for the User
  tour          Tour     @relation("TourBookings", fields: [tourId], references: [id])  // Relation to Tour
  tourId        String   @db.ObjectId  // Foreign key for the Tour
  numberOfSeats Int      // Number of seats booked
  startDate     DateTime // Start date of the tour booking
  createdAt     DateTime @default(now()) // Auto set the createdAt field
  updatedAt     DateTime @updatedAt      // Auto set the updatedAt field

  @@map("bookings")
}

model Place {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  tripadvisorData Json      // Unstructured data, stored as JSON
  createdAt       DateTime  @default(now())  // Auto set the createdAt field
  updatedAt       DateTime  @updatedAt       // Auto set the updatedAt field
  
  @@map("places")
}
