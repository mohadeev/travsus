// schema.prisma

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  email             String   @unique
  username          String?
  phone             String?
  password          String
  senders           Json?
  date              DateTime @default(now())
  library           Json?
  accountData       Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("users")
}
 


 model Tour {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  creator    Json     // Unstructured data, stored as JSON
  name       String
  subtitle   String
  overview   String
  slug       String
  images     String[] // Array of Strings
  people     String[] // Array of Strings
  services   String[] // Array of Strings
  places     String[] // Array of Strings
  highlights String[] // Array of Strings
  days       String[] // Array of Strings
  paths      String[] // Array of Strings
  price      String
  region     String[] // Array of Strings
  descount   String
  start      String // Reference to the StartEnd model
  end        String // Reference to the StartEnd model
  reviews    Json[]   // Array of JSON objects for storing reviews
  lang       String
  tourfor    String
  updated    Boolean  @default(false) // Default value set to false
  conclusion String
  tags       String[] // Array of Strings
  keyphrase  String[] // Array of Strings (corrected spelling from "keyphease")
  createdAt  DateTime @default(now())  // Auto set the createdAt field
  updatedAt  DateTime @updatedAt       // Auto set the updatedAt field
  @@map("tours")
}


model Place {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  tripadvisorData Json      // Unstructured data, stored as JSON
  createdAt       DateTime  @default(now())  // Auto set the createdAt field
  updatedAt       DateTime  @updatedAt       // Auto set the updatedAt field
  
  @@map("places")
} 