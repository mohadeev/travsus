 
NEXT_PUBLIC_GOOGLE_MAP_API_KEY=your_google_map_api_key
# https://visgl.github.io/react-google-maps/docs/get-started

NEXT_PUBLIC_GOOGLE_MAP_ID=your_google_map_id
# https://visgl.github.io/react-google-maps/docs/api-reference/components/advanced-marker

# Database (MongoDB Atlas). The site's data is in the `travsus` database of
# DATABASE_URL; countries/cities/places are in DATABASE_URL_PLACES.
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/
DATABASE_URL_PLACES=mongodb+srv://user:password@cluster.mongodb.net/travsusPlaces
# MONGODB_DB=travsus
