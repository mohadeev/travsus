		"Travel_Category_1": "Clothing",
		"Travel_Category_2": "Accessories",
		"Travel_Category_3": "Travel Essentials",
		"Travel_Category_4": "Health and Safety",
		"Travel_Category_5": "Technology",
		"Travel_Category_6": "Special Activities",
		"Travel_Category_7": "Cultural Considerations",
		"Travel_Category_8": "Optional Items",
		"Travel_Item_1_1": "Lightweight, breathable clothes: Cotton or linen for hot days.",
		"Travel_Item_1_2": "Modest clothing: Long skirts, dresses, and loose pants are recommended for women.",
		"Travel_Item_1_3": "Layers: A light jacket or sweater for cooler evenings and mountain areas.",
		"Travel_Item_1_4": "Comfortable shoes: For walking, hiking, and exploring cities like Marrakech and Fez.",
		"Travel_Item_1_5": "Swimwear: For beaches, pools, or traditional hammams (spas).",
		"Travel_Item_2_1": "Sunscreen and sunglasses: The sun can be intense, especially in desert areas.",
		"Travel_Item_2_2": "Wide-brimmed hat or scarf: For sun protection and to cover up when needed.",
		"Travel_Item_2_3": "Reusable water bottle: Stay hydrated while being eco-friendly.",
		"Travel_Item_2_4": "Daypack: For carrying essentials during day trips.",
		"Travel_Item_3_1": "Passport and visa (if required): Ensure they are valid for your travel dates.",
		"Travel_Item_3_2": "Travel insurance: For emergencies or unexpected situations.",
		"Travel_Item_3_3": "Cash in Moroccan Dirham (MAD): Many places, especially smaller shops, don't accept cards.",
		"Travel_Item_3_4": "Plug adapter: Morocco uses type C and E plugs, with a voltage of 220V.",
		"Travel_Item_4_1": "Basic first-aid kit: Include band-aids, pain relievers, and any prescription medications.",
		"Travel_Item_4_2": "Insect repellent: Useful, especially if visiting during warmer months.",
		"Travel_Item_4_3": "Hand sanitizer and wet wipes: For cleanliness on the go.",
		"Travel_Item_5_1": "Phone and charger: Consider purchasing a local SIM card for affordable internet access.",
		"Travel_Item_5_2": "Power bank: To keep devices charged during long excursions.",
		"Travel_Item_5_3": "Camera: To capture Morocco's stunning landscapes and architecture.",
		"Travel_Item_6_1": "Hiking gear: If trekking in the Atlas Mountains or other hiking areas.",
		"Travel_Item_6_2": "Warm clothing: If visiting the Sahara Desert at night, as temperatures can drop significantly.",
		"Travel_Item_6_3": "Snorkeling or diving gear: If planning water adventures along the coast.",
		"Travel_Item_7_1": "Small gifts: If invited to someone's home, it's polite to bring a token of appreciation.",
		"Travel_Item_7_2": "Phrasebook or translation app: Learning a few phrases in Tamazight or French can be helpful.",
		"Travel_Item_8_1": "Notebook or journal: To document your experiences.",
		"Travel_Item_8_2": "Books or e-reader: For downtime during travel.",
		"View_More_Reviews_Button": "View more 20 reviews",
		"What_To_Bring_Title": "What to bring"
	},
