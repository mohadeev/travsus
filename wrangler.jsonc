{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travsus",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // vinext's request handler plus the daily jobs (src/cloudflare/worker.ts)
  "main": "./src/cloudflare/worker.ts",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  },
  // Cache for pages and data (vite.config.ts → kvDataAdapter). See CLOUDFLARE.md.
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "c5f457ece26845599c8f58266402b4a4"
    }
  ],
  // This deploy's id, so the edge page cache starts fresh on every deploy
  // (src/cloudflare/worker.ts)
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // CPU time per request (paid plan); a tour page rendered for the first time needs more than 10 ms
  "limits": {
    "cpu_ms": 30000
  },
  // Same schedules (UTC) as vercel.json: daily balance charges and invite reminders
  "triggers": {
    "crons": [
      "0 6 * * *",
      "0 9 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
  // Secrets and settings (see CLOUDFLARE.md) are set in the Cloudflare dashboard
  // or with `npx wrangler secret put NAME`, never in this file.
}
