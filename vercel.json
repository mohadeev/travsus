{
	"version": 2,
	"builds": [
		{
			"src": "package.json",
			"use": "@vercel/next",
			"config": {
				"skipBuildCache": true,
				"buildCommand": "npm run build"
			}
		}
	],
	"routes": [{ "handle": "filesystem" }, { "src": "/(.*)", "dest": "/" }],
	"env": {
		"NEXT_PUBLIC_SKIP_API_ROUTES": "1",
		"NEXT_IGNORE_BUILD_ERRORS": "1"
	},
	"build": {
		"env": {
			"NEXT_PUBLIC_SKIP_API_ROUTES": "1",
			"NEXT_IGNORE_BUILD_ERRORS": "1"
		}
	},
	"functions": {
		"api/**/*.js": {
			"memory": 1024,
			"maxDuration": 10
		}
	},
	"github": {
		"silent": true
	}
}
